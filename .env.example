# ------------------------------------------------------------------
# Sesión
# ------------------------------------------------------------------

# Firma de la cookie HttpOnly (genera una con: openssl rand -base64 32)
SESSION_SECRET=

# ------------------------------------------------------------------
# Supabase (base de datos + auth multi-dispositivo)
# Sin estas variables la app usa el modo demo local (localStorage).
# ------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service Role Key (NUNCA exponerla al cliente; solo se usa en el servidor)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Correo — notificaciones de tareas por vencer
# Opción A (gratis, sin dominio): Gmail SMTP con "Contraseña de aplicaciones".
# Opción B: Resend (requiere dominio verificado, gratuito solo a tu propio correo).
# Si SMTP_HOST está configurado se usa SMTP; si no, se usa Resend.
# ------------------------------------------------------------------

# --- Opción A: Gmail SMTP (recomendada, gratis y sin dominio) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# El correo Gmail que autentica (debe tener 2FA + "Contraseña de aplicaciones")
SMTP_USER=
SMTP_PASS=
# Remitente. Con Gmail DEBE ser el mismo correo de SMTP_USER.
# EMAIL_FROM=Eunomia Tasks <tucorreo@gmail.com>

# --- Opción B: Resend ---
RESEND_API_KEY=
# Dominio verificado en Resend. Formato: "Eunomia Tasks <no-reply@tudominio.com>"
EMAIL_FROM=Eunomia Tasks <no-reply@tudominio.com>
# URL pública de la app (usa la de producción en Vercel para los enlaces firmados)
APP_URL=http://localhost:3000
# Hora local (0-23) en que se envían los avisos de tareas por vencer. Por defecto 8.
# Diario: vencidas/hoy a esa hora. Semanal: los lunes a esa hora (7 días siguientes).
MAIL_HOUR=8

# ------------------------------------------------------------------
# Cron / automatizaciones (Vercel la inyecta automáticamente)
# ------------------------------------------------------------------
CRON_SECRET=
# Uso personal: lista de cuentas permitidas (email/password) p. ej.:
# ALLOWED_EMAILS=david.crispoca@gmail.com,santicriscopa@gmail.com,est.david.crispoca@unimilitar.edu.co,alejatcuesta@gmail.com
ALLOWED_EMAILS=
