# ------------------------------------------------------------------
# Sesión
# ------------------------------------------------------------------

# Firma de la cookie HttpOnly (genera una con: openssl rand -base64 32)
SESSION_SECRET=

# ------------------------------------------------------------------
# Supabase (base de datos + auth multi-dispositivo)
# Sin estas variables la app usa el modo demo local (localStorage).
# ------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service Role Key (NUNCA exponerla al cliente; solo se usa en el servidor)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Correo (Resend) — notificaciones de tareas por vencer
# ------------------------------------------------------------------

RESEND_API_KEY=
# Dominio verificado en Resend. Formato: "Eunomia Tasks <no-reply@tudominio.com>"
EMAIL_FROM=Eunomia Tasks <no-reply@tudominio.com>
# URL pública de la app (usa la de producción en Vercel para los enlaces firmados)
APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# WhatsApp Business (Meta Cloud API)
# ------------------------------------------------------------------

WHATSAPP_TOKEN=
# ID numérico del teléfono de WhatsApp Business (Phone Number ID)
WHATSAPP_PHONE_ID=
# Token de verificación que elegiste al configurar el webhook en Meta
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta (verifica las firmas de los webhooks)
WHATSAPP_APP_SECRET=

# ------------------------------------------------------------------
# Google Calendar (OAuth2)
# ------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir con el "Authorized redirect URI" en Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback
# "primary" = calendario principal del usuario conectado
GOOGLE_CALENDAR_ID=primary

# ------------------------------------------------------------------
# Cron / automatizaciones (Vercel la inyecta automáticamente)
# ------------------------------------------------------------------
CRON_SECRET=
# Uso personal: solo esta cuenta puede entrar (Google OAuth y email/password)
ALLOWED_EMAILS=david.crispoca@gmail.com
