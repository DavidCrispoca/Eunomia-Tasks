# Supabase: deja vacío para modo demo/local sin sincronización en la nube.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Genera un valor aleatorio largo para producción.
SESSION_SECRET=
ALLOWED_EMAILS=
APP_URL=http://localhost:3000

# Correo: configura SMTP o Resend, además de EMAIL_FROM.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
EMAIL_FROM=
MAIL_HOUR=8
CRON_SECRET=

# Google Calendar OAuth (opcional).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_SECRET=
